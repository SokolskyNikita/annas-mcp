version: 2

project_name: annas-mcp

builds:
  - id: annas-mcp
    main: ./cmd/annas-mcp
    ldflags:
      - -s -w -X github.com/SokolskyNikita/annas-mcp/internal/version.Version=v{{.Version}}
    env:
      - CGO_ENABLED=0
    goos:
      - linux
      - freebsd
      - darwin
    goarch:
      - amd64
      - arm64
      - arm
    goarm:
      - "7"
    ignore:
      - goos: freebsd
        goarch: arm64
      - goos: freebsd
        goarch: arm
      - goos: darwin
        goarch: arm

  - id: annas-mcp-win
    main: ./cmd/annas-mcp
    ldflags:
      - -s -w -X github.com/SokolskyNikita/annas-mcp/internal/version.Version=v{{.Version}}
    env:
      - CGO_ENABLED=0
    goos:
      - windows
    goarch:
      - amd64
      - arm64

archives:
  - name_template: "{{ .ProjectName }}_{{ .Version }}_{{ .Os }}_{{ .Arch }}"
    formats:
      - tar.xz
    format_overrides:
      - goos: windows
        formats:
          - zip
    wrap_in_directory: true
    files:
      - README.md
      - CHANGELOG.md

checksum:
  name_template: "{{ .ProjectName }}_{{ .Version }}--checksums.txt"

release:
  draft: false

changelog:
  sort: asc
